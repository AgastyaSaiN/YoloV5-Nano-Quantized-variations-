# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# TensorFlow toolchain environment (recreate from requirements.txt; about 2 GB)
.venv/

# Datasets and annotations (re-creatable with scripts/prepare_data.py)
data/

# Raw per-model detection files (about 2.6 GB; regenerate with the evaluate_*.py scripts)
results/dets/
results/dets_*/

# Logs and profiler dumps
*.log
results/logs/

# Intermediate build files (calibration caches, split ONNX parts, SavedModels)
models/onnx_int8/_work/
models/tflite/_work/
models/onnx_int8/_prep.onnx
*_prep.onnx

# Downloaded source archive (the extracted vendor/yolov5/ folder is kept)
vendor/*.zip

# Editor, OS and tooling
.vscode/
.idea/
.claude/
.DS_Store
Thumbs.db
